{
	"name": "ecommerce-api",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run --watch index.ts",
		"build": "bun build index.ts --target bun --outdir dist",
		"start": "bun run dist/index.js",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"type-check": "biome check --write",
		"format:check": "biome format .",
		"lint:check": "biome lint .",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.8",
		"@types/bun": "latest",
		"@types/cookie-parser": "^1.4.10",
		"@types/node": "^25.5.0",
		"@types/pg": "^8.20.0",
		"prisma": "^7.5.0"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.5.0",
		"@prisma/client": "^7.5.0",
		"@types/bcrypt": "^6.0.0",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"dotenv": "^17.3.1",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.10.1",
		"pg": "^8.20.0",
		"zod": "^4.3.6"
	}
}
